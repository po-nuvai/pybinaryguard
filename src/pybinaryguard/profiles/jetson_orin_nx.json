  "recommendations": {
    "use_nvidia_containers": true,
    "prefer_l4t_base": "nvcr.io/nvidia/l4t-pytorch:r36.2.0",
    "install_from_source": [],
    "enable_max_performance": "sudo nvpmodel -m 0 && sudo jetson_clocks"
  },
  "validated_stacks": [
    {
      "name": "PyTorch 2.x + TensorRT",
      "packages": {
        "torch": "2.1.0",
        "torchvision": "0.16.0",
        "tensorrt": "8.6.2"
      }
    },
    {
      "name": "ONNX Runtime GPU",
      "packages": {
        "onnxruntime-gpu": "1.16.0",
        "numpy": "1.24.0"
      }
    }
  ]
